generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id      String   @id @default(cuid())
  name    String
  email   String   @unique
  image   String?
  Balance Balance?
  Orders  Orders[]
}

model Trade {
  id        Int      @default(autoincrement())
  tradeTime DateTime @map("trade_time") @db.Timestamptz(6)
  symbol    String
  price     Decimal  @db.Decimal(18, 8)
  quantity  Decimal  @db.Decimal(18, 8)

  @@id([id, tradeTime])
  @@index([symbol, tradeTime])
  @@map("Trade")
}

model Balance {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Money is stored in integer cents.
  total    BigInt @default(1000000)
  tradable BigInt @default(1000000)
  locked   BigInt @default(0)
}

model Orders {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     OrderType
  asset    String
  // Prices and quantity (lots) are integers scaled by 1e8. Margin and pnl are in cents.
  price    BigInt
  quantity BigInt
  margin   BigInt
  levarage Int

  stopLoss   BigInt?
  takeProfit BigInt?

  status      OrderStatus
  closePrice  BigInt?
  pnl         BigInt?
  closeReason CloseReason?
  createdAt   DateTime     @default(now())
  closedAt    DateTime?

  @@index([userId, status])
  @@index([status, asset])
}

enum CloseReason {
  MANUAL
  STOP_LOSS
  TAKE_PROFIT
  LIQUIDATION
}

enum OrderType {
  LONG
  SHORT
}

enum OrderStatus {
  OPEN
  CLOSED
  LIQUIDATED
}
