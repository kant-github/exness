generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id      String   @id @default(cuid())
  name    String
  email   String   @unique
  image   String?
  Balance Balance?
  Orders  Orders[]
}

model Trade {
  id        Int      @default(autoincrement())
  tradeTime DateTime @map("trade_time") @db.Timestamptz(6)
  symbol    String
  price     Decimal  @db.Decimal(18, 8)
  quantity  Decimal  @db.Decimal(18, 8)

  @@id([id, tradeTime])
  @@index([symbol, tradeTime])
  @@map("Trade")
}

model Balance {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  total    Decimal @default(10000) @db.Decimal(18, 2)
  tradable Decimal @default(10000) @db.Decimal(18, 2)
  locked   Decimal @default(0) @db.Decimal(18, 2)
}

model Orders {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      OrderType
  asset     String
  price     BigInt
  quantity  BigInt
  margin    BigInt
  levarage  Int
  decimals  Int
  status    OrderStatus
  createdAt DateTime    @default(now())

  closePrice BigInt?
  pnl        BigInt?
  closedAt   DateTime?

  @@index([userId, status])
  @@index([asset, status])
}

enum OrderType {
  LONG
  SHORT
}

enum OrderStatus {
  OPEN
  CLOSED
  LIQUIDATED
}
