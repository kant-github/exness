generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id      String   @id @default(cuid())
  name    String
  email   String   @unique
  image   String?
  Balance Balance?
  Orders  Orders[]
}

model Trade {
  id        Int      @default(autoincrement())
  tradeTime DateTime @map("trade_time") @db.Timestamptz(6)
  symbol    String
  price     Decimal  @db.Decimal(18, 8)
  quantity  Decimal  @db.Decimal(18, 8)

  @@id([id, tradeTime])
  @@index([symbol, tradeTime])
  @@map("Trade")
}

model Balance {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  total    Int @default(10000)
  tradable Int @default(10000)
  locked   Int @default(0)
}

model Orders {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type         OrderType
  asset        String
  entryType    EntryType   @default(MARKET)
  triggerPrice Decimal?    @db.Decimal(18, 8)
  price        Decimal     @default(0) @db.Decimal(18, 8)
  quantity     Decimal      @db.Decimal(18, 8)
  margin       Decimal      @default(0) @db.Decimal(18, 8)
  levarage     Int
  decimals     Int          @default(2)
  status       OrderStatus  @default(PENDING)
  stopLoss     Decimal?     @db.Decimal(18, 8)
  takeProfit   Decimal?     @db.Decimal(18, 8)
  closePrice   Decimal?     @db.Decimal(18, 8)
  closeReason  CloseReason?
  createdAt    DateTime     @default(now())
  openedAt     DateTime?
  closedAt     DateTime?

  @@index([asset, status])
  @@index([userId, status])
  @@map("Orders")
}

enum OrderType {
  LONG
  SHORT
}

enum EntryType {
  MARKET
  LIMIT
  STOP
}

enum OrderStatus {
  PENDING
  OPEN
  CLOSED
  REJECTED
  CANCELLED
}

enum CloseReason {
  USER
  STOP_LOSS
  TAKE_PROFIT
  LIQUIDATION
  INSUFFICIENT_FUNDS
}
